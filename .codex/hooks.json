{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "npm run lint",
            "timeout": 120,
            "statusMessage": "Running lint..."
          },
          {
            "type": "command",
            "command": "npm run test",
            "timeout": 120,
            "statusMessage": "Running tests..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "npm run format 1>&2",
            "timeout": 120,
            "statusMessage": "Formatting..."
          }
        ]
      }
    ]
  }
}
