{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "glossarygo",
  "title": "GlossaryGo",
  "description": "Search and update a private local YAML glossary",
  "icon": "extension-icon.png",
  "author": "kyrylo_avramenko",
  "platforms": [
    "macOS"
  ],
  "categories": [
    "Productivity"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.22.2"
  },
  "commands": [
    {
      "name": "search-term",
      "title": "Search Term",
      "description": "Find a term in your local glossary",
      "mode": "view"
    },
    {
      "name": "add-term",
      "title": "Add Term",
      "description": "Add a term and definition to your local glossary",
      "mode": "view"
    },
    {
      "name": "quick-add-term",
      "title": "Quick Add Term",
      "description": "Quickly add a term and definition to your local glossary",
      "mode": "no-view",
      "arguments": [
        {
          "name": "term",
          "placeholder": "Term",
          "type": "text",
          "required": true
        },
        {
          "name": "definition",
          "placeholder": "Definition",
          "type": "text",
          "required": true
        }
      ]
    }
  ],
  "preferences": [
    {
      "name": "glossaryFile",
      "title": "Glossary File",
      "description": "YAML format and example: https://github.com/kyrylo-1/GlossaryGo#glossary-format",
      "type": "file",
      "required": false
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.4.1",
    "@raycast/utils": "^2.3.0",
    "micromark": "4.0.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "19.0.10",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^9.22.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "eslint-plugin-unicorn": "^61.0.2",
    "jsdom": "^30.0.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "rebuild": "npm run build && npm run dev",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "prepublishOnly": "echo \"\\n\\nIt seems like you are trying to publish the Raycast extension to npm.\\n\\nIf you did intend to publish it to npm, remove the \\`prepublishOnly\\` script and rerun \\`npm publish\\` again.\\nIf you wanted to publish it to the Raycast Store instead, use \\`npm run publish\\` instead.\\n\\n\" && exit 1",
    "publish": "npx @raycast/api@latest publish",
    "test": "vitest run",
    "format": "prettier --write .",
    "check:format": "prettier --check ."
  }
}
